{
  "manifest_version": 3,
  "name": "Copy Selected Tab URLs",
  "version": "0.1.0",
  "description": "Copy highlighted Chrome tab URLs in tab-strip order.",
  "minimum_chrome_version": "109",
  "permissions": [
    "tabs",
    "offscreen",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/copy_all-16.png",
    "32": "icons/copy_all-32.png",
    "48": "icons/copy_all-48.png",
    "128": "icons/copy_all-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/copy_all-16.png",
      "32": "icons/copy_all-32.png",
      "48": "icons/copy_all-48.png",
      "128": "icons/copy_all-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "copy-selected-tab-urls": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Copy selected tab URLs"
    }
  }
}
